<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.flimmerboxyt" name="FlimmerBoxYT" version="1.5.0" provider-name="TiTanX Lab">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="plugin.video.youtube" version="6.0.0" optional="false"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="de">FlimmerBoxYT – YouTube nach Genre</summary>
    <description lang="de">Deutschsprachige YouTube-Inhalte nach Genre: Filme, Dokus, Kinder, Autos, Technik, Reisen, Kochen, Gaming, Finanzen, Musik und mehr. Mit Kanalverwaltung, Favoriten und Suche. Benötigt YouTube-Addon und API-Key.</description>
    <platform>all</platform>
    <language>de</language>
    <license>GPL-2.0</license>
    <assets>
      <icon>resources/media/icon.png</icon>
      <fanart>resources/media/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
