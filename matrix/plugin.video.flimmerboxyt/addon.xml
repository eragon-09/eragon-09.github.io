<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.flimmerboxyt" name="FlimmerBoxYT" version="1.6.4" provider-name="[COLOR silver]TiTan[/COLOR][COLOR lime]X[/COLOR] [COLOR dimgray]Lab[/COLOR] Team">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.module.requests" version="2.31.0"/>
    <import addon="inputstream.adaptive" version="21.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup" />
  <extension point="xbmc.addon.metadata">
    <summary lang="de">FlimmerBoxYT – YouTube nach Genre</summary>
    <description lang="de">Deutschsprachige YouTube-Inhalte nach Genre: Filme, Dokus, Kinder, Autos, Technik, Reisen, Kochen, Gaming, Finanzen, Musik und mehr. Mit Kanalverwaltung, Favoriten und Suche. Eigenständige YouTube-Wiedergabe mit nativem Resolver und InputStream Adaptive; kein YouTube-Addon und kein API-Key nötig.</description>
    <platform>all</platform>
    <language>de</language>
    <license>GPL-2.0</license>
    <assets>
      <icon>resources/media/icon.png</icon>
      <fanart>resources/media/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
